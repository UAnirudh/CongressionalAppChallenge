# Server-side only. Set these in Vercel for the environments you deploy.
AI_PROVIDER=nvidia
NVIDIA_API_KEY=
# Use a supported NVIDIA model enabled on your account. No automatic model fallback.
NVIDIA_MODEL=openai/gpt-oss-20b

# Optional alternative: set AI_PROVIDER=openai for a model with image input and JSON mode.
OPENAI_API_KEY=
OPENAI_MODEL=
