# Server-side only. Set these in Vercel for the environments you deploy.
AI_PROVIDER=nvidia
NVIDIA_API_KEY=
# Use a supported NVIDIA model enabled on your account. No automatic model fallback.
NVIDIA_MODEL=openai/gpt-oss-20b
# Optional interpreter model. When NVIDIA_MODEL is Nemotron, typed problems use
# GPT-OSS 20B by default; set this to override that choice.
# NVIDIA_TEXT_MODEL=openai/gpt-oss-20b

# Optional image provider alongside NVIDIA text. A Groq key enables image uploads.
# Keep this server-side in each Vercel environment that should accept images.
GROQ_API_KEY=
# Defaults to this model when omitted. Other model IDs are rejected.
GROQ_MODEL=qwen/qwen3.8-27b

# Optional alternative: set AI_PROVIDER=openai for a model with image input and JSON mode.
OPENAI_API_KEY=
OPENAI_MODEL=
